# Generate a URL-safe password, e.g. openssl rand -hex 24. Never commit .env.
YUANPU_DB_PASSWORD=
YUANPU_DB_PORT=54328
YUANPU_SERVER_PORT=8788

# Optional BookStack layer. Keep this file private and generate independent
# values before enabling compose.bookstack.yaml.
YUANPU_BOOKSTACK_URL=
YUANPU_BOOKSTACK_TOKEN_ID=
YUANPU_BOOKSTACK_TOKEN_SECRET=
YUANPU_BOOKSTACK_ALLOW_HTTP=false
# YUANPU_BOOKSTACK_PUBLIC_URL=http://127.0.0.1:6875
# YUANPU_BOOKSTACK_PORT=6875
# YUANPU_BOOKSTACK_APP_KEY=base64:...
# YUANPU_BOOKSTACK_DB_PASSWORD=...
# YUANPU_BOOKSTACK_DB_ROOT_PASSWORD=...
