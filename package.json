{
  "name": "@yuanpu-agent/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"@yuanpu-agent/*\" --filter \"!@yuanpu-agent/monorepo\" run build",
    "build:app": "pnpm --filter @yuanpu-agent/app... run build",
    "build:desktop": "pnpm --filter @yuanpu-agent/desktop... run build",
    "build:python-artifact": "node apps/python-capabilities/scripts/build-artifact.mjs",
    "build:runtime": "pnpm --filter @yuanpu-agent/runtime... run build",
    "build:native": "pnpm --filter @yuanpu-agent/runtime run build:native",
    "check": "pnpm run build && pnpm run typecheck:yuanpu && pnpm run check:server && pnpm run test",
    "build:server": "node server/scripts/eap.mjs build",
    "dev:server": "node server/scripts/eap.mjs dev",
    "generate:server": "pnpm --filter @yuanpu-agent/server-client exec openapi-typescript ../../server/eap/api/mindlink-openapi.yaml -o ../../server/eap/api/schema.gen.ts",
    "check:server": "node server/scripts/eap.mjs fmt && node server/scripts/eap.mjs vet && node server/scripts/eap.mjs test && node server/scripts/eap.mjs runtime && pnpm run build:server && pnpm run build:server:web",
    "build:server:legacy": "node server/backend/scripts/go.mjs build",
    "dev:server:legacy": "node server/backend/scripts/go.mjs dev",
    "dev:server:web:legacy": "pnpm --filter @yuanpu-agent/server-web run dev",
    "build:server:web:legacy": "pnpm --filter @yuanpu-agent/server-web run build",
    "migrate:server:legacy": "node server/backend/scripts/go.mjs migrate",
    "generate:server:legacy": "node server/backend/scripts/go.mjs generate && pnpm --filter @yuanpu-agent/server-client run generate",
    "check:server:legacy": "node server/backend/scripts/check-generated.mjs && node server/backend/scripts/go.mjs vet && node server/backend/scripts/go.mjs test && pnpm run build:server:legacy && pnpm --filter @yuanpu-agent/server-client run build && pnpm --filter @yuanpu-agent/server-client run typecheck && pnpm --filter @yuanpu-agent/server-client run test && pnpm run smoke:server:legacy",
    "smoke:server:legacy": "node server/backend/scripts/smoke.mjs && node server/backend/scripts/smoke.mjs --dev-runner",
    "smoke:server:compose:legacy": "pnpm --filter @yuanpu-agent/server-client run build && node server/backend/scripts/compose-smoke.mjs",
    "smoke:server:compose": "pnpm run smoke:server:compose:legacy",
    "dev:server:web": "node server/scripts/eap.mjs web",
    "build:server:web": "node server/scripts/eap.mjs portal",
    "dev": "pnpm build && pnpm --filter @yuanpu-agent/desktop run dev",
    "package:desktop": "pnpm run build && pnpm run build:native && pnpm run smoke:native && pnpm --filter @yuanpu-agent/desktop run package",
    "package:native": "pnpm --filter @yuanpu-agent/runtime run package:native",
    "prepare:python-capabilities": "uv sync --frozen --project apps/python-capabilities",
    "presmoke:native": "pnpm run prepare:python-capabilities && pnpm run build:python-artifact && pnpm run smoke:python-artifact",
    "pretest": "pnpm run prepare:python-capabilities",
    "release:manifest": "pnpm --filter @yuanpu-agent/runtime run release:manifest",
    "smoke:native": "pnpm --filter @yuanpu-agent/runtime run smoke:native && pnpm run smoke:runtime-update",
    "smoke:python-artifact": "node apps/python-capabilities/scripts/smoke-artifact.mjs",
    "smoke:runtime-update": "pnpm --filter @yuanpu-agent/desktop... run build && node apps/desktop/scripts/smoke-runtime-updater.mjs",
    "start": "pnpm run dev",
    "test:jev-evidence": "node --test scripts/verification/test/*.test.mjs",
    "test": "node --test apps/python-capabilities/scripts/*.test.mjs scripts/verification/test/*.test.mjs && pnpm -r --filter \"@yuanpu-agent/*\" --filter \"!@yuanpu-agent/monorepo\" --if-present run test",
    "typecheck": "pnpm run typecheck:yuanpu",
    "typecheck:yuanpu": "pnpm -r --filter \"@yuanpu-agent/*\" --filter \"!@yuanpu-agent/monorepo\" run typecheck"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260120.1",
    "@types/node": "^24.13.6",
    "https-proxy-agent": "9.1.0",
    "tsdown": "0.23.0",
    "tsx": "4.22.1",
    "typescript": "6.0.2"
  }
}
