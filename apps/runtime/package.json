{
  "name": "@yuanpu-agent/runtime",
  "version": "0.1.0",
  "description": "Yuanpu Agent native runtime sidecar.",
  "type": "module",
  "bin": {
    "yuanpu-runtime": "dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linxinhong/yuanpu-agent.git",
    "directory": "apps/runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/generate-assistant-skills.mjs && tsdown",
    "build:native": "pnpm run build && node scripts/native/build.mjs",
    "package:native": "node scripts/native/package.mjs",
    "release:manifest": "node scripts/native/produce-manifest.mjs",
    "smoke:native": "node scripts/native/smoke.mjs",
    "start": "node dist/index.cjs",
    "test": "node --test test/*.test.mjs test/task-050-memory-refresh-probe.mjs",
    "typecheck": "node scripts/generate-assistant-skills.mjs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@yuanpu-agent/assistant": "workspace:*",
    "@yuanpu-agent/runtime-kit": "workspace:*",
    "@yuanpu-agent/protocol": "workspace:*",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
