{
  "name": "@yuanpu-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Yuanpu Agent Electron desktop shell.",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/prepare-emo-icon.mjs && electron-builder --config electron-builder.yml --publish never",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yuanpu-agent/protocol": "workspace:*",
    "@yuanpu-agent/server-client": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
